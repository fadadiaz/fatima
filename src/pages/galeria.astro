---
import { getCollection } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Layout from '../layouts/Layout.astro'
import NavSecundario from '../components/NavSecundario.astro'
import Footer from '../components/Footer.astro'
import { crearAleatorio } from '../scripts/aleatorio'

// Semilla del orden de las fotos
const SEMILLA_ORDEN = 7
// Miniaturas que se cargan de entrada: las primeras en orden, visibles en la primera pantalla
const CARGA_INMEDIATA = 6

const proyectos = await getCollection('proyectos')

// Mismas imágenes que el slider: solo el primer nivel de cada carpeta, sin las subcarpetas otras/
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/proyectos/*/*.{png,jpg,jpeg,gif,webp}',
  { eager: true }
)

const nombreDeRuta = (ruta: string) => ruta.split('/').pop() ?? ruta
// Nombre original a partir del src optimizado: sin consulta ni hash del build
const nombreDeSrc = (src: string) =>
  (src.split('?')[0].split('/').pop() ?? src).replace(/\.[^.]+(?=\.\w+$)/, '')

// Exclusiones por nombre de archivo: las portadas de cada proyecto y la última imagen de Nubes (decorativa)
const portadas = proyectos.map((proyecto) => nombreDeSrc(proyecto.data.portada.src))
const ultimaDeNubes = Object.keys(imagenes)
  .filter((ruta) => ruta.startsWith('/src/assets/proyectos/nubes/'))
  .map(nombreDeRuta)
  .sort()
  .at(-1)
const EXCLUIR = [...portadas, ultimaDeNubes].filter(Boolean)

const disponibles = proyectos
  .flatMap((proyecto) => {
    if (!proyecto.data.carpeta) return []
    const prefijo = `/src/assets${proyecto.data.carpeta}/`
    return Object.entries(imagenes)
      .filter(([ruta]) => ruta.startsWith(prefijo) && !EXCLUIR.includes(nombreDeRuta(ruta)))
      .map(([ruta, modulo]) => ({
        ruta,
        imagen: modulo.default,
        proyecto: proyecto.id,
        titulo: proyecto.data.titulo,
        href: `/proyectos/${proyecto.id}`,
      }))
  })
  .sort((a, b) => a.ruta.localeCompare(b.ruta))

// Orden mezclado con semilla, evitando dos imágenes seguidas del mismo proyecto cuando se puede
const azar = crearAleatorio(SEMILLA_ORDEN)
const mezcla = disponibles
  .map((foto) => ({ foto, clave: azar() }))
  .sort((a, b) => a.clave - b.clave)
  .map(({ foto }) => foto)

const orden: typeof mezcla = []
while (mezcla.length) {
  const anterior = orden.at(-1)?.proyecto
  const restantes = (id: string) => mezcla.filter((foto) => foto.proyecto === id).length
  const candidatas = mezcla.filter((foto) => foto.proyecto !== anterior)
  // Primero el proyecto con más imágenes pendientes, para que no queden juntas al final
  const elegida = candidatas.length
    ? candidatas.reduce((mejor, foto) => (restantes(foto.proyecto) > restantes(mejor.proyecto) ? foto : mejor))
    : mezcla[0]
  orden.push(elegida)
  mezcla.splice(mezcla.indexOf(elegida), 1)
}

// Versión grande para el visor
const fotos = await Promise.all(
  orden.map(async (foto) => ({
    ...foto,
    grande: await getImage({ src: foto.imagen, width: Math.min(1600, foto.imagen.width) }),
  }))
)
---

<Layout
  titulo="Galería - Fátima Díaz"
  descripcion="Galería de imágenes de los proyectos de Fátima Díaz, diseñadora gráfica y web en Buenos Aires."
>
  <NavSecundario />
  <main>
    <h1 class="galeria-titulo">Galería</h1>
    <section class="galeria" aria-label="Imágenes de los proyectos">
      {fotos.map((foto, i) => (
        <button
          type="button"
          class="galeria-foto"
          aria-label={`Ver imagen de ${foto.titulo}`}
          data-titulo={foto.titulo}
          data-href={foto.href}
          data-grande={foto.grande.src}
          data-ancho={foto.imagen.width}
          data-alto={foto.imagen.height}
        >
          <Image
            src={foto.imagen}
            alt=""
            width={480}
            densities={[1, 2]}
            loading={i < CARGA_INMEDIATA ? 'eager' : 'lazy'}
            draggable="false"
          />
        </button>
      ))}
    </section>
  </main>

  <dialog class="visor" aria-label="Visor de imágenes">
    <div class="visor-contenido">
      <img class="visor-imagen" alt="" />
      <div class="visor-barra">
        <p class="visor-proyecto"></p>
        <div class="visor-acciones">
          <a class="btn btn-pink visor-ver" href="/proyectos">Ver proyecto</a>
          <button type="button" class="btn btn-pink visor-anterior">Anterior</button>
          <button type="button" class="btn btn-pink visor-siguiente">Siguiente</button>
          <button type="button" class="btn btn-pink visor-cerrar">Cerrar</button>
        </div>
      </div>
    </div>
  </dialog>

  <Footer />
</Layout>

<style>
  /* Título para lectores de pantalla y buscadores */
  .galeria-titulo {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Mosaico */
  .galeria {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-16);
    padding: var(--space-48);
    background-color: var(--fa-white);
    user-select: none;
  }

  .galeria-foto {
    display: block;
    width: 100%;
    cursor: pointer;
    -webkit-user-drag: none;
  }

  .galeria-foto :global(img) {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .galeria {
      grid-template-columns: repeat(2, 1fr);
      padding: var(--space-16);
    }
  }

  /* Visor a pantalla completa */
  .visor {
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: none;
    padding: var(--space-24) var(--space-48);
    background-color: var(--fa-white);
    color: var(--fa-black);
  }

  .visor::backdrop {
    background-color: var(--fa-white);
  }

  .visor-contenido {
    height: 100%;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-24);
  }

  .visor-imagen {
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
  }

  .visor-barra {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-16);
  }

  .visor-proyecto {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .visor-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  @media (max-width: 768px) {
    .visor {
      padding: var(--space-16);
    }
  }
</style>

<script>
  const botones = [...document.querySelectorAll<HTMLButtonElement>('.galeria-foto')]

  // Visor
  const visor = document.querySelector<HTMLDialogElement>('.visor')
  const imagen = visor?.querySelector<HTMLImageElement>('.visor-imagen')
  const nombre = visor?.querySelector<HTMLElement>('.visor-proyecto')
  const ver = visor?.querySelector<HTMLAnchorElement>('.visor-ver')
  const cerrar = visor?.querySelector<HTMLButtonElement>('.visor-cerrar')
  let indice = 0
  let origen: HTMLButtonElement | null = null

  function mostrar(i: number) {
    if (!imagen || !nombre || !ver) return
    indice = (i + botones.length) % botones.length
    const boton = botones[indice]
    imagen.src = boton.dataset.grande ?? ''
    imagen.width = Number(boton.dataset.ancho)
    imagen.height = Number(boton.dataset.alto)
    imagen.alt = `Imagen de ${boton.dataset.titulo}`
    nombre.textContent = boton.dataset.titulo ?? ''
    ver.href = boton.dataset.href ?? '/proyectos'
  }

  if (visor && cerrar) {
    botones.forEach((boton, i) => {
      boton.addEventListener('click', () => {
        origen = boton
        mostrar(i)
        visor.showModal()
        cerrar.focus()
      })
    })

    visor.querySelector('.visor-anterior')?.addEventListener('click', () => mostrar(indice - 1))
    visor.querySelector('.visor-siguiente')?.addEventListener('click', () => mostrar(indice + 1))
    cerrar.addEventListener('click', () => visor.close())

    visor.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(indice - 1)
      if (e.key === 'ArrowRight') mostrar(indice + 1)
    })

    // Al cerrar, el foco vuelve a la foto de origen sin mover la página
    visor.addEventListener('close', () => origen?.focus({ preventScroll: true }))
  }
</script>
