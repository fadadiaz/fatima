---
import Layout from '../layouts/Layout.astro'
import NavSecundario from '../components/NavSecundario.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  titulo="Recursos - Fátima Díaz"
  descripcion="Recursos y links organizados por Fátima Díaz, diseñadora gráfica y web en Buenos Aires."
>
  <NavSecundario />
  <main class="margin-main">
    <header class="max-width min-padding">
      <div class="subtitulo">
        <h1>Recursos</h1>
      </div>
    </header>
    <section class="recursos max-width min-padding">
      <p>Próximamente</p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .recursos {
    text-align: center;
  }
</style>
