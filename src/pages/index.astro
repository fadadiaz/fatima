---
import Layout from '../layouts/Layout.astro'
import HeaderHome from '../components/HeaderHome.astro'
import Footer from '../components/Footer.astro'
import NavSecundario from '../components/NavSecundario.astro'
import AreaItem from '../components/AreaItem.astro'
import Slider from '../components/Slider.astro'
import { Image } from 'astro:assets'
import emojiPin from '../assets/emojis/emoji_u1f4cd_3d.png'
import emojiComputadora from '../assets/emojis/emoji_u1f4bb_3d.png'
import emojiBirrete from '../assets/emojis/emoji_u1f393_3d.png'

const areas = [
  { 
    texto: "Identidad visual", 
    descripcion: "Construimos juntos la imagen de tu marca, desde cero o a partir de la identidad que ya tenés. Me enfoco en que sea coherente, genuina y lista para usarse en cualquier contexto, digital o impreso. Diseño para que se vea bien y funcione.",
    tags: [
      { texto: "Branding" },
      { texto: "Rediseño de marca" },
      { texto: "Kit para redes" },
      { texto: "Papelería corporativa" },
      { texto: "Etiquetas y packaging" },
      { texto: "Presentaciones" },
      { texto: "Manual de marca" },
      { texto: "Paleta de colores" },
    ]
  },
  { 
    texto: "Diseño web", 
    descripcion: "Tu página web no debería ser un dolor de cabeza, ni para vos ni para quienes la usan. Diseño según las necesidades reales de cada proyecto, ya sea que arranques desde cero o quieras mejorar lo que ya tenés.",
    tags: [
      { texto: "Landing pages" },
      { texto: "WordPress" },
      { texto: "Tiendas online" },
      { texto: "Notion" },
      { texto: "Portfolios" },
      { texto: "Menú digital" },
      { texto: "Figma a código" },
      { texto: "UI Design" },
      { texto: "Rediseño web" },
      { texto: "Mantenimiento web" },
    ]
  },
  {
    texto: "Diseño editorial",
    descripcion: "Revistas, libros, afiches y folletos pensados como un conjunto: el concepto, la tipografía, el ritmo de cada página y cómo va a imprimirse. Me ocupo desde la idea hasta la maquetación y la preprensa.",
    tags: [
      { texto: "Revistas" },
      { texto: "Libros" },
      { texto: "Afiches" },
      { texto: "Folletos" },
      { texto: "Maquetación" },
      { texto: "Preprensa" },
    ]
  },
  {
    texto: "Herramientas digitales",
    descripcion: "Más allá del diseño, te ayudo a automatizar tareas repetitivas y a crear herramientas a medida que simplifican cómo trabajás. Formularios inteligentes, documentos que se generan solos, aplicaciones de gestión para el celular: soluciones que te ahorran tiempo real.",
    tags: [
      { texto: "Automatización" },
      { texto: "Formularios inteligentes" },
      { texto: "Apps a medida" },
      { texto: "Gestión de clientes" },
      { texto: "AppSheet" },
      { texto: "Apps Script" },
      { texto: "Google Workspace" },
      { texto: "Generación de documentos" },
      { texto: "Control de stock" },
    ]
  },
]
---

<Layout>
  <HeaderHome />
  <NavSecundario flotante={true} />
  <main>
    <section id="hero" class="font-grotesk max-width min-padding h-100 center-h">
      <p data-cursor="/cursor-yo.png">¡Hola! Soy Fátima, diseñadora en <Image class="emoji emoji-pin" src={emojiPin} width={42} height={42} densities={[1, 2]} loading="eager" alt="" aria-hidden="true" /> Buenos Aires. Diseño marcas, publicaciones, páginas web y <Image class="emoji" src={emojiComputadora} width={42} height={42} densities={[1, 2]} loading="eager" alt="" aria-hidden="true" /> automatizo tareas diarias. Estoy terminando <Image class="emoji" src={emojiBirrete} width={42} height={42} densities={[1, 2]} loading="eager" alt="" aria-hidden="true" /> Diseño y Comunicación Visual.</p>
      <a class="btn btn-pink" href="/sobre-mi">Más sobre mí</a>
    </section>
    <section id="areas" data-cursor="/cursor-proyectos.gif" class="font-grotesk max-width min-padding">
      <div class="subtitulo">
        <h2>Especialidades</h2>
      </div>
      {areas.map((area) => (
        <AreaItem texto={area.texto} descripcion={area.descripcion} tags={area.tags} />
      ))}
    </section>
    <section id="slider-proyectos">
      <div class="max-width min-padding">
        <div class="subtitulo">
          <h2>Proyectos</h2>
          <a class="btn btn-pink" href="/proyectos">Ver todo<i class="fi fi-rs-eye"></i></a>
        </div>
      </div>
      <Slider />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  #hero {
    flex-direction: column;
    justify-content: center;
    gap: var(--space-16);
  }

  #hero p {
    font-size: var(--text-2-5xl);
    line-height: var(--text-3xl);
    text-align: center;
  }

  /* Emojis decorativos alineados con el texto, sin agrandar el alto de línea */
  #hero :global(.emoji) {
    display: inline;
    height: 1.05em;
    width: auto;
    vertical-align: -0.1em;
    margin-block: -0.15em;
  }

  #hero :global(.emoji-pin) {
    height: 0.85em;
    vertical-align: 0.1em;
  }

  /* Las etiquetas cortadas por el borde no generan scroll horizontal */
  #areas {
    overflow-x: clip;
    /* Flecha estándar en toda la sección; el nombre de cada área usa la manito */
    cursor: default;
  }

  #slider-proyectos {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-48);
    margin-bottom: var(--space-64);
  }

  @media (max-width: 768px) {
    #hero p {
      font-size: var(--text-2xl);
      line-height: var(--text-2xl);
    }
    h2 {
      font-size: var(--text-2xl);
    }
  }
</style>

<script>
  const headerHome = document.querySelector('.header-home') as HTMLElement
  const navFlotante = document.querySelector('.nav-flotante') as HTMLElement

  if (headerHome && navFlotante) {
    window.addEventListener('scroll', () => {
      const headerBottom = headerHome.getBoundingClientRect().bottom
      
      if (headerBottom > 0) {
        // header visible — ocultar nav flotante
        navFlotante.classList.remove('visible')
      } else {
        // header fuera de pantalla — mostrar nav flotante
        navFlotante.classList.add('visible')
      }
    }, { passive: true })
  }
</script>