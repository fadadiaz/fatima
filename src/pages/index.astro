---
import Layout from '../layouts/Layout.astro'
import HeaderHome from '../components/HeaderHome.astro'
import Footer from '../components/Footer.astro'
import NavSecundario from '../components/NavSecundario.astro'
import AreaItem from '../components/AreaItem.astro'
import Slider from '../components/Slider.astro'
import { Image } from 'astro:assets'
import emojiPin from '../assets/emojis/emoji_u1f4cd_3d.png'
import emojiComputadora from '../assets/emojis/emoji_u1f4bb_3d.png'
import emojiBirrete from '../assets/emojis/emoji_u1f393_3d.png'

const areas = [
  { 
    texto: "Identidad visual", 
    descripcion: "Construimos juntos la imagen de tu marca, desde cero o a partir de la identidad que ya tenés. Me enfoco en que sea coherente, genuina y lista para usarse en cualquier contexto, digital o impreso. Diseño para que se vea bien y funcione.",
    tags: [
      { texto: "Branding" },
      { texto: "Rediseño de marca" },
      { texto: "Kit para redes" },
      { texto: "Papelería corporativa" },
      { texto: "Etiquetas y packaging" },
      { texto: "Presentaciones" },
      { texto: "Manual de marca" },
      { texto: "Paleta de colores" },
    ]
  },
  { 
    texto: "Diseño web", 
    descripcion: "Tu página web no debería ser un dolor de cabeza, ni para vos ni para quienes la usan. Diseño según las necesidades reales de cada proyecto, ya sea que arranques desde cero o quieras mejorar lo que ya tenés.",
    tags: [
      { texto: "Landing pages" },
      { texto: "WordPress" },
      { texto: "Tiendas online" },
      { texto: "Notion" },
      { texto: "Portfolios" },
      { texto: "Menú digital" },
      { texto: "Figma a código" },
      { texto: "UI Design" },
      { texto: "Rediseño web" },
      { texto: "Mantenimiento web" },
    ]
  },
  {
    texto: "Diseño editorial",
    descripcion: "Revistas, libros, afiches y folletos pensados como un conjunto: el concepto, la tipografía, el ritmo de cada página y cómo va a imprimirse. Me ocupo desde la idea hasta la maquetación y la preprensa.",
    tags: [
      { texto: "Revistas" },
      { texto: "Libros" },
      { texto: "Afiches" },
      { texto: "Folletos" },
      { texto: "Maquetación" },
      { texto: "Preprensa" },
    ]
  },
  {
    texto: "Herramientas digitales",
    descripcion: "Más allá del diseño, te ayudo a automatizar tareas repetitivas y a crear herramientas a medida que simplifican cómo trabajás. Formularios inteligentes, documentos que se generan solos, aplicaciones de gestión para el celular: soluciones que te ahorran tiempo real.",
    tags: [
      { texto: "Automatización" },
      { texto: "Formularios inteligentes" },
      { texto: "Apps a medida" },
      { texto: "Gestión de clientes" },
      { texto: "AppSheet" },
      { texto: "Apps Script" },
      { texto: "Google Workspace" },
      { texto: "Generación de documentos" },
      { texto: "Control de stock" },
    ]
  },
]
---

<Layout>
  <HeaderHome />
  <NavSecundario flotante={true} />
  <main>
    <section id="hero" class="font-grotesk max-width min-padding h-100 center-h">
      <p data-cursor="/cursor-yo.png" data-reveal="intro" data-reveal-salida data-reveal-umbrales="presentacion">¡Hola! Soy Fátima, diseñadora en <Image class="emoji emoji-pin" src={emojiPin} width={42} height={42} densities={[1, 2]} loading="eager" alt="" aria-hidden="true" /> Buenos Aires. Diseño marcas, publicaciones, páginas web y <Image class="emoji" src={emojiComputadora} width={42} height={42} densities={[1, 2]} loading="eager" alt="" aria-hidden="true" /> automatizo tareas diarias. Estoy terminando <Image class="emoji" src={emojiBirrete} width={42} height={42} densities={[1, 2]} loading="eager" alt="" aria-hidden="true" /> Diseño y Comunicación Visual.</p>
      <a class="btn btn-pink hero-boton" href="/sobre-mi">Más sobre mí</a>
    </section>
    <section id="areas" data-cursor="/cursor-proyectos.gif" class="font-grotesk max-width min-padding">
      <div class="subtitulo">
        <h2>Especialidades</h2>
      </div>
      {areas.map((area) => (
        <AreaItem texto={area.texto} descripcion={area.descripcion} tags={area.tags} />
      ))}
    </section>
    <section id="slider-proyectos">
      <div class="max-width min-padding">
        <div class="subtitulo">
          <h2>Proyectos</h2>
          <a class="btn btn-pink" href="/proyectos">Ver todo<i class="fi fi-rs-eye"></i></a>
        </div>
      </div>
      <Slider />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  #hero {
    flex-direction: column;
    justify-content: center;
    gap: var(--space-16);
  }

  #hero p {
    font-size: var(--text-2-5xl);
    line-height: var(--text-3xl);
    text-align: center;
  }

  /* Emojis decorativos alineados con el texto, sin agrandar el alto de línea */
  #hero :global(.emoji) {
    display: inline;
    height: 1.05em;
    width: auto;
    vertical-align: -0.1em;
    margin-block: -0.15em;
  }

  #hero :global(.emoji-pin) {
    height: 0.85em;
    vertical-align: 0.1em;
  }

  /* "Más sobre mí" aparece cuando la presentación terminó de revelarse */
  .hero-boton {
    transition: opacity 0.4s ease, visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) #hero p:not(.revelado) + .hero-boton {
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease, visibility 0s linear 0.4s;
    }
  }

  /* Las etiquetas cortadas por el borde no generan scroll horizontal */
  #areas {
    overflow-x: clip;
    /* Flecha estándar en toda la sección; el nombre de cada área usa la manito */
    cursor: default;
  }

  #slider-proyectos {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-48);
    margin-bottom: var(--space-64);
  }

  @media (max-width: 768px) {
    #hero p {
      font-size: var(--text-2xl);
      line-height: var(--text-2xl);
    }
    h2 {
      font-size: var(--text-2xl);
    }
  }
</style>

<script>
  import '../scripts/revelar'

  // Curva de todas las variantes de entrada del menú flotante
  const CURVA = 'cubic-bezier(0.22, 1, 0.36, 1)'
  // 1, caída suave: duración de la entrada, en ms
  const CAIDA_ENTRADA = 450
  // 1, caída suave: duración de la salida, en ms
  const CAIDA_SALIDA = 250
  // 1, caída suave: distancia desde la que baja (100% es el alto del menú)
  const CAIDA_DISTANCIA = '100%'
  // 2, persiana: duración de la entrada, en ms
  const PERSIANA_ENTRADA = 450
  // 2, persiana: duración de la salida, en ms
  const PERSIANA_SALIDA = 250
  // 3, links escalonados: duración de la entrada de cada link, en ms
  const LINKS_ENTRADA = 400
  // 3, links escalonados: duración de la salida, en ms
  const LINKS_SALIDA = 200
  // 3, links escalonados: distancia desde la que sube cada link
  const LINKS_DISTANCIA = '8px'
  // 3, links escalonados: retraso entre un link y el siguiente, en ms
  const LINKS_RETRASO = 60

  const VARIANTES: Record<string, { entrada: number; salida: number; distancia: string; retraso: number }> = {
    '1': { entrada: CAIDA_ENTRADA, salida: CAIDA_SALIDA, distancia: CAIDA_DISTANCIA, retraso: 0 },
    '2': { entrada: PERSIANA_ENTRADA, salida: PERSIANA_SALIDA, distancia: '0px', retraso: 0 },
    '3': { entrada: LINKS_ENTRADA, salida: LINKS_SALIDA, distancia: LINKS_DISTANCIA, retraso: LINKS_RETRASO },
  }

  const headerHome = document.querySelector<HTMLElement>('.header-home')
  const navFlotante = document.querySelector<HTMLElement>('.nav-flotante')
  // Menú del hero: los links en escritorio, el botón del menú plegable en celular
  const menusHero = document.querySelectorAll<HTMLElement>('.header-home .nav-full, .header-home .btn-burger')
  const movimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // Menú inaccesible: fuera del tabulado y oculto para lectores de pantalla
  const ocultar = (elemento: HTMLElement, oculto: boolean) => {
    elemento.inert = oculto
    if (oculto) elemento.setAttribute('aria-hidden', 'true')
    else elemento.removeAttribute('aria-hidden')
  }

  if (headerHome && navFlotante) {
    // Temporal: variante de entrada elegida con ?menu=1, 2 o 3; sin parámetro, la original
    const id = new URLSearchParams(location.search).get('menu') ?? ''
    const variante = VARIANTES[id]
    if (variante && !movimientoReducido) {
      navFlotante.dataset.animacion = id
      navFlotante.style.setProperty('--nav-entrada', `${variante.entrada}ms`)
      navFlotante.style.setProperty('--nav-salida', `${variante.salida}ms`)
      navFlotante.style.setProperty('--nav-distancia', variante.distancia)
      navFlotante.style.setProperty('--nav-retraso', `${variante.retraso}ms`)
      navFlotante.style.setProperty('--nav-curva', CURVA)

      // Orden de entrada del logo y los links en cada fila (escritorio y celular)
      navFlotante.querySelectorAll('.nav-alt-full, .nav-alt-mobile').forEach((fila) => {
        const items = [...fila.querySelectorAll<HTMLElement>(':scope > a, :scope > .btn-burger')]
        items.forEach((item, i) => {
          item.classList.add('nav-item')
          item.style.setProperty('--i', String(i))
        })
      })
    }

    // El flotante aparece solo cuando el encabezado completo salió por arriba
    const actualizar = () => {
      const visible = headerHome.getBoundingClientRect().bottom <= 0
      navFlotante.classList.toggle('visible', visible)
      ocultar(navFlotante, !visible)
      menusHero.forEach((menu) => ocultar(menu, visible))
    }

    new IntersectionObserver(actualizar).observe(headerHome)
  }
</script>