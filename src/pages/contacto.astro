---
import Layout from '../layouts/Layout.astro'
import NavSecundario from '../components/NavSecundario.astro'
import CorreoGrande from '../components/CorreoGrande.astro'
---

<Layout
  titulo="Contacto - Fátima Díaz"
  descripcion="Contactá a Fátima Díaz, diseñadora en Buenos Aires: por correo, llamada o videollamada."
>
  <div class="pantalla-contacto bg-green">
    <NavSecundario bg="bg-green" />
    <main class="contacto min-padding">
      <h1 class="font-alt">¡Hablemos!</h1>
      <CorreoGrande />
    </main>
  </div>
</Layout>

<style>
  /* Pantalla única en verde, con el menú incluido */
  .pantalla-contacto {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  /* Título y correo centrados en el espacio que deja el menú */
  .contacto {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-48);
    padding-block: var(--space-48);
  }

  .contacto h1 {
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: var(--text-2xl);
  }

  /* El correo conserva su ancho máximo, centrado */
  .contacto > :global(.correo) {
    width: 100%;
  }

  .contacto :global(.correo-imagen) {
    margin-inline: auto;
  }
</style>
