---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { getImage } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import NavSecundario from '../../components/NavSecundario.astro'
import Footer from '../../components/Footer.astro'
import Visor from '../../components/Visor.astro'

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos')
  const rutas = proyectos.map((proyecto) => `/proyectos/${proyecto.id}`)
  // Anterior y siguiente en el orden de la colección; en los extremos pasan al otro extremo
  return proyectos.map((proyecto: CollectionEntry<'proyectos'>, i: number) => ({
    params: { slug: proyecto.id },
    props: {
      proyecto,
      anterior: rutas[(i - 1 + rutas.length) % rutas.length],
      siguiente: rutas[(i + 1) % rutas.length],
      otros: rutas.filter((_, j) => j !== i),
    },
  }))
}

const { proyecto, anterior, siguiente, otros } = Astro.props as {
  proyecto: CollectionEntry<'proyectos'>
  anterior: string
  siguiente: string
  otros: string[]
}
const { Content } = await render(proyecto)

// Descripción recortada a unos 160 caracteres para buscadores y redes
const textoDescripcion = (proyecto.data.descripcion ?? '').replace(/\s+/g, ' ').trim()
const descripcion = textoDescripcion.length > 160
  ? textoDescripcion.slice(0, textoDescripcion.lastIndexOf(' ', 157)) + '…'
  : textoDescripcion || `${proyecto.data.titulo}, proyecto de ${proyecto.data.categoria.toLowerCase()} de Fátima Díaz.`

// Versión liviana de la portada para redes (1200×630)
const ogImagen = await getImage({
  src: proyecto.data.portada,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 75,
})
---

<Layout
  titulo={`${proyecto.data.titulo} - Fátima Díaz`}
  descripcion={descripcion}
  imagen={ogImagen.src}
>
  <NavSecundario />
  <main class="margin-main">
    <header class="proyecto-header max-width min-padding grid-12">
      <h1 class="proyecto-titulo col" style="--start: 1; --end: 12;">{proyecto.data.titulo}</h1>
      <p class="proyecto-categoria col" style="--start: 1; --end: 3;">{proyecto.data.categoria}</p>
      <p class="proyecto-descripcion col" style="--start: 3; --end: 9;">{proyecto.data.descripcion}</p>
      {proyecto.data.enlaces && (
        <div class="proyecto-enlaces col" style="--start: 3; --end: 9;">
          {proyecto.data.enlaces.map((enlace) => (
            <a class="btn-link" href={enlace.href} target="_blank"><span class="subrayado">{enlace.texto}</span></a>
          ))}
        </div>
      )}
    </header>
    <section class="proyecto-body max-width min-padding">
      <Content />
    </section>
    <nav class="proyecto-navegacion max-width min-padding" aria-label="Otros proyectos">
      <a class="subrayado" href={anterior}>anterior</a>
      <a class="subrayado proyecto-aleatorio" href={otros[0] ?? '/proyectos'} data-otros={JSON.stringify(otros)}>aleatorio</a>
      <a class="subrayado" href={siguiente}>siguiente</a>
    </nav>
  </main>
  <Footer />
  <Visor />
</Layout>

<style>
  .proyecto-header {
    width: 100%;
    row-gap: var(--space-16);
  }

  /* Título del proyecto; 5rem no está en la escala */
  .proyecto-titulo {
    font-size: 5rem;
    letter-spacing: -0.05em;
  }

  @media (max-width: 768px) {
    .proyecto-titulo {
      font-size: var(--text-3xl);
    }
  }

  /* Categoría a la izquierda de la primera línea del párrafo; tipografía provisoria en una sola variable */
  .proyecto-categoria {
    --categoria-fuente: 400 var(--text-sm) / var(--text-lg) var(--font-mono);
    font: var(--categoria-fuente);
    text-transform: uppercase;
    align-self: start;
  }

  /* Navegación entre proyectos: anterior, aleatorio y siguiente */
  .proyecto-navegacion {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    padding-top: var(--space-48);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: var(--text-lg);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .proyecto-navegacion a:first-child {
    justify-self: start;
  }

  .proyecto-navegacion a:last-child {
    justify-self: end;
  }

  @media (max-width: 768px) {
    .proyecto-navegacion {
      display: flex;
      justify-content: space-between;
    }
  }

  /* Imágenes del cuerpo que abren el visor */
  :global(.js) .proyecto-body :global(:is(img, video)) {
    cursor: pointer;
    transition: opacity 400ms ease;
  }

  .proyecto-body.atenuado :global(:is(img, video)) {
    opacity: var(--visor-opacidad-fondo);
  }

  .proyecto-descripcion {
    white-space: pre-line;
}

  /* Entrada escalonada de los bloques en orden de lectura; --orden lo asigna el script */
  main {
    --bloque-escalon: 90ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) :is(.proyecto-header, .proyecto-body) > :global(*) {
      opacity: 0;
      translate: 0 var(--space-16);
    }

    :global(.js) :is(.proyecto-header, .proyecto-body) > :global(.bloque-visible) {
      opacity: 1;
      translate: none;
      transition:
        opacity 600ms var(--entrada-curva) calc(var(--orden, 0) * var(--bloque-escalon)),
        translate 600ms var(--entrada-curva) calc(var(--orden, 0) * var(--bloque-escalon));
    }
  }

  .proyecto-enlaces {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    gap: var(--space-16);
}

  .proyecto-body {
      gap: var(--space-8);
      display: flex;
      flex-direction: column;
  }

  .proyecto-body :global(:is(img, video)) {
    height: auto;
  }

  .proyecto-body :global(p) {
    gap: var(--space-8);
    display: flex;
    flex-direction: column;
    font-size: var(--text-base);
  }

  .proyecto-body :global(.agrupado) {
  display: grid;
  grid-template-columns: repeat(45, 1fr); 
  gap: var(--space-8);
  width: 100%;
  align-items: stretch;
}

.proyecto-body :global(.agrupado .img-h) {
  grid-column: span 35; 
}

.proyecto-body :global(.agrupado .img-v) {
  grid-column: span 10;
}

.proyecto-body :global(.agrupado .img-h-30) {
  grid-column: span 30; 
}

.proyecto-body :global(.agrupado .img-v-15) {
  grid-column: span 15;
}

.proyecto-body :global(.agrupado :is(img, video)) {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.proyecto-body :global(.agrupado-50) {
  display: flex;
  gap: var(--space-8);
}

.proyecto-body :global(.agrupado-50 img) {
  flex: 1;
  min-width: 0;
  object-fit: cover;
}

@media (max-width: 768px) {
  .proyecto-body :global(.agrupado) {
    grid-template-columns: 1fr;
  }

  .proyecto-body :global(.agrupado-50) {
    flex-direction: column;
  }
  
  .proyecto-body :global(.agrupado .img-h),
  .proyecto-body :global(.agrupado .img-v),
  .proyecto-body :global(.agrupado .img-h-30),
  .proyecto-body :global(.agrupado .img-v-15) {
    grid-column: span 1;
  }

  .proyecto-body :global(.agrupado :is(img, video)),
  .proyecto-body :global(.agrupado-50 img) {
    height: auto;
    width: 100%;
  }
}
</style>

<script>
  // Escalón entre bloques, en ms, y cantidad de bloques con retraso propio
  const ESCALON = 90
  const TOPE = 12

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector<HTMLElement>('main')?.style.setProperty('--bloque-escalon', `${ESCALON}ms`)
    const bloques = [...document.querySelectorAll<HTMLElement>('.proyecto-header > *, .proyecto-body > *')]
    const mostrar = (bloque: Element) => bloque.classList.add('bloque-visible')

    // Bloques fuera de la primera pantalla: aparecen al entrar, sin retraso
    const entrada = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        mostrar(entry.target)
        entrada.unobserve(entry.target)
      })
    })

    const primeraPantalla: HTMLElement[] = []
    bloques.forEach((bloque) => {
      if (bloque.getBoundingClientRect().top < window.innerHeight) {
        bloque.style.setProperty('--orden', String(Math.min(primeraPantalla.length, TOPE - 1)))
        primeraPantalla.push(bloque)
      } else {
        entrada.observe(bloque)
      }
    })
    requestAnimationFrame(() => requestAnimationFrame(() => primeraPantalla.forEach(mostrar)))
  }
</script>

<script>
  import { crearVisor } from '../../scripts/visor'
  import { ANCHOS_PROYECTO } from '../../lib/imagenes'

  // Ancho de la versión que abre el visor: alcanza para pantalla completa sin bajar el original
  const ANCHO_VISOR = 1800
  // Ancho máximo de la versión que carga el zoom
  const ANCHO_ZOOM = ANCHOS_PROYECTO.at(-1) ?? 2592

  // La mayor versión del srcset que no pase del ancho dado, o el src si no hay srcset
  const mayor = (img: HTMLImageElement, limite: number) => {
    const candidatas = (img.getAttribute('srcset') ?? '')
      .split(',')
      .map((parte) => parte.trim().split(/\s+/))
      .filter(([url]) => url)
      .map(([url, ancho]) => ({ url, ancho: parseFloat(ancho) || 0 }))
      .sort((a, b) => b.ancho - a.ancho)
    const elegida = candidatas.find((candidata) => candidata.ancho <= limite) ?? candidatas.at(-1)
    return {
      url: elegida?.url ?? img.getAttribute('src') ?? '',
      ancho: elegida?.ancho || Number(img.getAttribute('width')) || img.naturalWidth,
    }
  }

  const cuerpo = document.querySelector<HTMLElement>('.proyecto-body')
  const titulo = document.querySelector('.proyecto-titulo')?.textContent?.trim() ?? ''
  // Imágenes y videos de animación, en orden de lectura
  const fotos = [...(cuerpo?.querySelectorAll<HTMLImageElement | HTMLVideoElement>('img, video.animacion') ?? [])]

  const visor = crearVisor({
    imagenes: fotos.map((foto) =>
      foto instanceof HTMLVideoElement
        ? {
            src: foto.poster,
            grande: foto.poster,
            video: foto.dataset.src,
            ancho: Number(foto.getAttribute('width')) || 1,
            alto: Number(foto.getAttribute('height')) || 1,
            alt: foto.getAttribute('aria-label') ?? '',
          }
        : {
            src: foto.getAttribute('src') ?? '',
            grande: mayor(foto, ANCHO_VISOR).url,
            zoom: mayor(foto, ANCHO_ZOOM).url,
            anchoZoom: mayor(foto, ANCHO_ZOOM).ancho,
            ancho: Number(foto.getAttribute('width')) || foto.naturalWidth || 1,
            alto: Number(foto.getAttribute('height')) || foto.naturalHeight || 1,
            alt: foto.alt,
          }
    ),
    alAbrir: () => cuerpo?.classList.add('atenuado'),
    alCerrar: () => cuerpo?.classList.remove('atenuado'),
  })

  // Cada imagen del cuerpo se vuelve un botón que abre el visor
  if (visor) {
    fotos.forEach((img, i) => {
      img.setAttribute('role', 'button')
      img.tabIndex = 0
      img.setAttribute('aria-label', `Ver imagen ${i + 1} de ${titulo}`)
      img.addEventListener('click', () => visor.abrir(img, i))
      img.addEventListener('keydown', (e) => {
        const tecla = (e as KeyboardEvent).key
        if (tecla !== 'Enter' && tecla !== ' ') return
        e.preventDefault()
        visor.abrir(img, i)
      })
    })
  }

  // Aleatorio: un proyecto distinto del actual, elegido al hacer clic
  const aleatorio = document.querySelector<HTMLAnchorElement>('.proyecto-aleatorio')
  aleatorio?.addEventListener('click', (e) => {
    const otros: string[] = JSON.parse(aleatorio.dataset.otros ?? '[]')
    if (!otros.length) return
    e.preventDefault()
    window.location.href = otros[Math.floor(Math.random() * otros.length)]
  })
</script>
