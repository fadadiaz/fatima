---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { getImage } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import NavSecundario from '../../components/NavSecundario.astro'
import Footer from '../../components/Footer.astro'

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos')
  return proyectos.map((proyecto: CollectionEntry<'proyectos'>) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }))
}

const { proyecto } = Astro.props as { proyecto: CollectionEntry<'proyectos'> }
const { Content } = await render(proyecto)

// Descripción recortada a unos 160 caracteres para buscadores y redes
const textoDescripcion = (proyecto.data.descripcion ?? '').replace(/\s+/g, ' ').trim()
const descripcion = textoDescripcion.length > 160
  ? textoDescripcion.slice(0, textoDescripcion.lastIndexOf(' ', 157)) + '…'
  : textoDescripcion || `${proyecto.data.titulo}, proyecto de ${proyecto.data.categoria.toLowerCase()} de Fátima Díaz.`

// Versión liviana de la portada para redes (1200×630)
const ogImagen = await getImage({
  src: proyecto.data.portada,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 75,
})
---

<Layout
  titulo={`${proyecto.data.titulo} - Fátima Díaz`}
  descripcion={descripcion}
  imagen={ogImagen.src}
>
  <NavSecundario />
  <main class="margin-main">
    <header class="proyecto-header max-width min-padding grid-12">
      <p class="btn btn-alt bg-pink proyecto-categoria font-mono col" style="--start: 1; --end: 12;">{proyecto.data.categoria}</p>
      <h1 class="proyecto-titulo col" style="--start: 1; --end: 12;">{proyecto.data.titulo}</h1>
      <p class="proyecto-descripcion col" style="--start: 3; --end: 9;">{proyecto.data.descripcion}</p>
      {proyecto.data.enlaces && (
        <div class="proyecto-enlaces col" style="--start: 3; --end: 9;">
          {proyecto.data.enlaces.map((enlace) => (
            <a class="btn-link" href={enlace.href} target="_blank"><span class="subrayado">{enlace.texto}</span></a>
          ))}
        </div>
      )}
    </header>
    <section class="proyecto-body max-width min-padding">
      <Content />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .proyecto-header {
    width: 100%;
    row-gap: var(--space-16);
  }

  .proyecto-categoria {
    font-size: var(--text-sm);
    text-transform: none;
}

  .proyecto-descripcion {
    white-space: pre-line;
}

  /* Entrada escalonada de los bloques en orden de lectura; --orden lo asigna el script */
  main {
    --bloque-duracion: 600ms;
    --bloque-distancia: 16px;
    --bloque-escalon: 90ms;
    --bloque-curva: cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) :is(.proyecto-header, .proyecto-body) > :global(*) {
      opacity: 0;
      translate: 0 var(--bloque-distancia);
    }

    :global(.js) :is(.proyecto-header, .proyecto-body) > :global(.bloque-visible) {
      opacity: 1;
      translate: none;
      transition:
        opacity var(--bloque-duracion) var(--bloque-curva) calc(var(--orden, 0) * var(--bloque-escalon)),
        translate var(--bloque-duracion) var(--bloque-curva) calc(var(--orden, 0) * var(--bloque-escalon));
    }
  }

  .proyecto-enlaces {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    gap: var(--space-16);
}

  .proyecto-body {
      gap: var(--space-8);
      display: flex;
      flex-direction: column;
  }

  .proyecto-body :global(img) {
    height: auto;
  }

  .proyecto-body :global(p) {
    gap: var(--space-8);
    display: flex;
    flex-direction: column;
    font-size: var(--text-base);
  }

  .proyecto-body :global(.agrupado) {
  display: grid;
  grid-template-columns: repeat(45, 1fr); 
  gap: var(--space-8);
  width: 100%;
  align-items: stretch;
}

.proyecto-body :global(.agrupado .img-h) {
  grid-column: span 35; 
}

.proyecto-body :global(.agrupado .img-v) {
  grid-column: span 10;
}

.proyecto-body :global(.agrupado .img-h-30) {
  grid-column: span 30; 
}

.proyecto-body :global(.agrupado .img-v-15) {
  grid-column: span 15;
}

.proyecto-body :global(.agrupado img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.proyecto-body :global(.agrupado-50) {
  display: flex;
  gap: var(--space-8);
}

.proyecto-body :global(.agrupado-50 img) {
  flex: 1;
  min-width: 0;
  object-fit: cover;
}

@media (max-width: 768px) {
  .proyecto-body :global(.agrupado) {
    grid-template-columns: 1fr;
  }

  .proyecto-body :global(.agrupado-50) {
    flex-direction: column;
  }
  
  .proyecto-body :global(.agrupado .img-h),
  .proyecto-body :global(.agrupado .img-v),
  .proyecto-body :global(.agrupado .img-h-30),
  .proyecto-body :global(.agrupado .img-v-15) {
    grid-column: span 1;
  }

  .proyecto-body :global(.agrupado img),
  .proyecto-body :global(.agrupado-50 img) {
    height: auto;
    width: 100%;
  }
}
</style>

<script>
  // Escalón entre bloques, en ms, y cantidad de bloques con retraso propio
  const ESCALON = 90
  const TOPE = 12

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector<HTMLElement>('main')?.style.setProperty('--bloque-escalon', `${ESCALON}ms`)
    const bloques = [...document.querySelectorAll<HTMLElement>('.proyecto-header > *, .proyecto-body > *')]
    const mostrar = (bloque: Element) => bloque.classList.add('bloque-visible')

    // Bloques fuera de la primera pantalla: aparecen al entrar, sin retraso
    const entrada = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        mostrar(entry.target)
        entrada.unobserve(entry.target)
      })
    })

    const primeraPantalla: HTMLElement[] = []
    bloques.forEach((bloque) => {
      if (bloque.getBoundingClientRect().top < window.innerHeight) {
        bloque.style.setProperty('--orden', String(Math.min(primeraPantalla.length, TOPE - 1)))
        primeraPantalla.push(bloque)
      } else {
        entrada.observe(bloque)
      }
    })
    requestAnimationFrame(() => requestAnimationFrame(() => primeraPantalla.forEach(mostrar)))
  }
</script>
