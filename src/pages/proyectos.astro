---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import NavSecundario from '../components/NavSecundario.astro'
import Footer from '../components/Footer.astro'

const proyectos = await getCollection('proyectos')
---

<Layout
  titulo="Proyectos - Fátima Díaz"
  descripcion="Proyectos de identidad visual, diseño web, diseño editorial y herramientas digitales de Fátima Díaz, diseñadora gráfica y web en Buenos Aires."
>
  <NavSecundario />
  <main class="margin-main">
    <header class="max-width min-padding">
      <div class="subtitulo">
        <h1>Proyectos</h1>
        <button id="btn-azar" type="button" class="btn btn-pink">Al azar <i class="fi fi-rs-dice-alt"></i></button>
      </div>
    </header>
    <section class="grilla-proyectos grid-12 max-width min-padding">
      {proyectos.map((proyecto: CollectionEntry<'proyectos'>) => (
        <a href={`/proyectos/${proyecto.id}`} class="proyecto-card col" style="--start: auto; --end: span 4;">
          <div class="proyecto-cover">
            <Image
              src={proyecto.data.portada}
              alt={proyecto.data.titulo}
              widths={[450, 900]}
              sizes="(max-width: 599px) 100vw, (max-width: 1023px) 50vw, 33vw"
              loading="lazy"
            />
          </div>
          <div class="proyecto-card-info">
            <h3 class="btn-link">{proyecto.data.titulo}</h3>
            <p class="font-mono">{proyecto.data.fecha}</p>
          </div>
        </a>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Grilla de tarjetas: 3 columnas en escritorio, 2 en tablet y 1 en celular.
     Los espacios entre tarjetas son los de .grid-12 */
  .grilla-proyectos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .grilla-proyectos .proyecto-card {
    grid-column: auto;
  }

  @media (max-width: 1023px) {
    .grilla-proyectos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 599px) {
    .grilla-proyectos {
      grid-template-columns: 1fr;
    }
  }

  .proyecto-card {
      display: flex;
      flex-direction: column;
      gap: var(--space-16);
  }

  .proyecto-cover {
      padding: var(--space-24);
      background: var(--fa-gray);
  }

  .proyecto-card img {
      width: 100%;
      height: auto;
      max-height: 592px;
      aspect-ratio: 1 / 1.414;
      object-fit: cover;
  }

  .proyecto-card-info {
    display: flex;
    flex-direction: row;
    gap: var(--space-8);
    justify-content: space-between;
    white-space: nowrap;
  }
</style>

<script define:vars={{ proyectos: proyectos.map(p => p.id) }}>
  const btn = document.getElementById('btn-azar')
  btn.addEventListener('click', (e) => {
    e.preventDefault()
    const azar = proyectos[Math.floor(Math.random() * proyectos.length)]
    window.location.href = `/proyectos/${azar}`
  })
</script>
