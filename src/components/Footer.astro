---
import CorreoGrande from './CorreoGrande.astro'
import BotonLlamada from './BotonLlamada.astro'
---

<footer id="contacto" class="bg-green min-padding h-80">

  <div class="hook">
    <p data-entrada-palabras>Estoy disponible para proyectos independientes, colaboraciones o trabajo full-time.</p>
    <BotonLlamada />
  </div>
  <CorreoGrande />

</footer>

<style>
footer {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-48);
    gap: var(--space-48);
    justify-content: flex-end;
}

.hook {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xl);
    line-height: var(--text-2xl);
    flex-wrap: wrap;
}

.hook p {
    max-width: 432px;
}

.hook {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-16);
}

/* Desde que el botón ya no entra al lado del párrafo: párrafo, correo y botón, en columna */
@media (max-width: 719px) {
    .hook {
        display: contents;
    }

    .hook p {
        order: 1;
    }

    footer > :global(.correo) {
        order: 2;
    }

    .hook :global(.btn) {
        order: 3;
    }
}
</style>

<script>
  import '../scripts/entrada-palabras'
</script>
