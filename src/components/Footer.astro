---
import CorreoGrande from './CorreoGrande.astro'
import BotonLlamada from './BotonLlamada.astro'
---

<footer id="contacto" class="bg-green min-padding h-80">

  <div class="hook">
    <p class="hook-escritorio" data-entrada-palabras>Estoy disponible para proyectos independientes.</p>
    <p class="hook-movil" data-entrada-palabras>Disponible para proyectos independientes.</p>
    <BotonLlamada />
  </div>
  <CorreoGrande />

</footer>

<style>
footer {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-48);
    gap: var(--space-48);
    justify-content: flex-end;
}

.hook {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xl);
    line-height: var(--text-2xl);
    flex-wrap: wrap;
}

.hook p {
    max-width: 432px;
}

.hook {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-16);
}

/* Texto de disponibilidad según el ancho; display: none lo saca también de los lectores de pantalla */
.hook-movil {
    display: none;
}

@media (max-width: 768px) {
    .hook-escritorio {
        display: none;
    }

    .hook-movil {
        display: block;
    }
}
</style>

<script>
  import '../scripts/entrada-palabras'
</script>
