---
const asunto = encodeURIComponent('Quiero agendar una llamada')
const cuerpo = encodeURIComponent('Hola Fátima, me gustaría agendar una llamada.')
const mailtoLlamada = `mailto:hola@fatima.com.ar?subject=${asunto}&body=${cuerpo}`
---

<footer id="contacto" class="bg-green min-padding h-80">

  <div class="hook">
    <div class="hook-texto">
      <p>Estoy disponible para proyectos independientes, colaboraciones o trabajo full-time.</p>
      <a class="btn btn-fill" href={mailtoLlamada}>Agendá una llamada</a>
    </div>
    <p class="font-alt">¡Hablemos!</p>
  </div>
  <div class="correo">
    <a class="correo-link" href="mailto:hola@fatima.com.ar">
      <img class="correo-default" alt="hola@fatima.com.ar" src="/correo-link.svg">
      <img class="correo-hover" alt="" aria-hidden="true" src="/correo-link-sub.svg">
    </a>
  </div>

</footer>

<style>
footer {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-48);
    gap: var(--space-48);
    justify-content: flex-end;
}

.correo-link {
    display: block;
    position: relative;
    width: 100%;
}

/* Subrayado que se revela de izquierda a derecha sobre el correo */
.correo-hover {
  position: absolute;
  inset: 0;
  width: 100%;
  clip-path: inset(0 100% 0 0);
  transition: clip-path 0.5s ease;
}

.correo-link:hover .correo-hover,
.correo-link:focus-visible .correo-hover {
  clip-path: inset(0 0 0 0);
}

@media (prefers-reduced-motion: reduce) {
  .correo-hover {
    transition: none;
  }
}

.hook {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xl);
    line-height: var(--text-2xl);
    flex-wrap: wrap;
}

.hook p {
    max-width: 432px;
}

.hook {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-16);
}

.hook-texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
}
</style>
