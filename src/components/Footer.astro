---
import CorreoGrande from './CorreoGrande.astro'
import BotonLlamada from './BotonLlamada.astro'
---

<footer id="contacto" class="bg-green min-padding h-80">

  <div class="hook">
    <p data-entrada-palabras>Estoy disponible para proyectos independientes, colaboraciones o trabajo full-time.</p>
    <BotonLlamada />
  </div>
  <CorreoGrande>
    <BotonLlamada slot="llamada" />
  </CorreoGrande>

</footer>

<style>
footer {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-48);
    gap: var(--space-48);
    justify-content: flex-end;
}

.hook {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xl);
    line-height: var(--text-2xl);
    flex-wrap: wrap;
}

.hook p {
    max-width: 432px;
}

.hook {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-16);
}

/* Celular y sin hover: el botón de llamada pasa a la fila de acciones del correo */
@media (max-width: 719px), (hover: none) {
    .hook > :global(.btn) {
        display: none;
    }
}
</style>

<script>
  import '../scripts/entrada-palabras'
</script>
