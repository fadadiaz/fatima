---
const correo = 'hola@fatima.com.ar'
const asunto = encodeURIComponent('Quiero agendar una llamada')
const cuerpo = encodeURIComponent('Hola Fátima, me gustaría agendar una llamada.')
const mailtoLlamada = `mailto:${correo}?subject=${asunto}&body=${cuerpo}`
---

<footer id="contacto" class="bg-green min-padding h-80">

  <div class="hook">
    <p>Estoy disponible para proyectos independientes, colaboraciones o trabajo full-time.</p>
    <a class="btn btn-fill btn-llamada" href={mailtoLlamada}>Agendá una llamada<i class="fi fi-rs-envelope"></i></a>
  </div>
  <div class="correo">
    <div class="correo-imagen" tabindex="0">
      <img alt={correo} src="/correo-link.svg">
      <span class="correo-linea" aria-hidden="true"></span>
    </div>
    <div class="correo-opciones">
      <a class="btn-tag bg-pink" href={`mailto:${correo}`}>enviar email</a>
      <button type="button" class="btn-tag bg-pink correo-copiar" data-correo={correo}>copiar email</button>
    </div>
    <span class="aviso-copiado" role="status"></span>
  </div>

</footer>

<style>
footer {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-48);
    gap: var(--space-48);
    justify-content: flex-end;
}

.correo {
    position: relative;
}

.correo-imagen {
    position: relative;
}

/* Subrayado dibujado sobre el SVG, revelado con una máscara de izquierda a derecha */
.correo-linea {
    position: absolute;
    left: 0;
    top: 88.65%;
    width: 94.75%;
    height: 5.45%;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.5s ease;
}

/* Dos tramos sólidos, con el corte bajo la arroba */
.correo-linea::before,
.correo-linea::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: var(--fa-black);
}

.correo-linea::before {
    left: 0;
    width: 22.26%;
}

.correo-linea::after {
    left: 28.04%;
    right: 0;
}

.correo:hover .correo-linea,
.correo:focus-within .correo-linea {
    clip-path: inset(0 0 0 0);
}

/* Opciones del correo superpuestas en el centro */
.correo-opciones {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
}

/* Mismo alto que el resto de los botones */
.correo-opciones .btn-tag {
    min-height: var(--btn-height);
}

.correo:hover .correo-opciones,
.correo:focus-within .correo-opciones {
    opacity: 1;
    pointer-events: auto;
}

.aviso-copiado {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .correo-linea,
  .correo-opciones {
    transition: none;
  }
}

.hook {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xl);
    line-height: var(--text-2xl);
    flex-wrap: wrap;
}

.hook p {
    max-width: 432px;
}

.hook {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-16);
}

/* Botón de la llamada más grande en celular */
@media (max-width: 768px) {
  .btn-llamada {
    --btn-height: 44px;
    font-size: var(--text-base);
  }
}
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.correo-copiar').forEach((boton) => {
    const aviso = boton.closest('.correo')?.querySelector('.aviso-copiado')
    const textoOriginal = boton.textContent
    let espera: number | undefined

    boton.addEventListener('click', async () => {
      const correo = boton.dataset.correo ?? ''
      try {
        await navigator.clipboard.writeText(correo)
        boton.textContent = 'email copiado'
        if (aviso) aviso.textContent = 'Email copiado'
      } catch {
        boton.textContent = 'no se pudo copiar'
      }
      window.clearTimeout(espera)
      espera = window.setTimeout(() => {
        boton.textContent = textoOriginal
        if (aviso) aviso.textContent = ''
      }, 2000)
    })
  })
</script>
