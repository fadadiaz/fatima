---
// Correo grande con subrayado y menú de enviar y copiar (pie y contacto)

// Textos de las acciones del correo
const TEXTO_ENVIAR = 'enviar email'
const TEXTO_COPIAR = 'copiar email'
const TEXTO_COPIADO = 'copiado'

const correo = 'hola@fatima.com.ar'

// Subrayado en las medidas del SVG del correo (viewBox 1798 × 165), con el corte bajo la arroba
const linea = { y: 146.8, alto: 9.5, corteInicio: 399.75, corteFin: 515.75, ancho: 1798 }

// Identificador propio para vincular el correo con sus opciones
const idOpciones = `correo-opciones-${Math.random().toString(36).slice(2, 8)}`
---

<div class="correo">
  <a class="correo-imagen correo-enlace" href={`mailto:${correo}`}>
    <img alt={correo} src="/correo-link.svg">
  </a>
  <button
    type="button"
    class="correo-imagen correo-boton"
    aria-expanded="false"
    aria-controls={idOpciones}
  >
    <img alt={correo} src="/correo-link.svg">
    <svg class="correo-linea" viewBox="0 0 1798 165" aria-hidden="true">
      <rect x="0" y={linea.y} width={linea.corteInicio} height={linea.alto} />
      <rect x={linea.corteFin} y={linea.y} width={linea.ancho - linea.corteFin} height={linea.alto} />
    </svg>
  </button>
  <div class="correo-opciones" id={idOpciones} role="group" aria-label="Opciones de contacto">
    <a class="btn btn-alt correo-enviar" href={`mailto:${correo}`}>{TEXTO_ENVIAR}</a>
    <span class="correo-separador" aria-hidden="true"></span>
    <button
      type="button"
      class="btn btn-alt correo-copiar"
      data-correo={correo}
      data-texto={TEXTO_COPIAR}
      data-copiado={TEXTO_COPIADO}
    >{TEXTO_COPIAR}</button>
  </div>
  <span class="aviso-copiado" role="status"></span>
</div>

<style>
.correo {
    position: relative;
}

/* El contenedor toma el tamaño del SVG para que el subrayado coincida siempre */
.correo-imagen {
    display: block;
    position: relative;
    width: fit-content;
    max-width: 100%;
}

/* Sin JavaScript, el correo es un enlace mailto */
.correo-boton,
:global(.js) .correo-enlace {
    display: none;
}

:global(.js) .correo-boton {
    display: block;
}

/* Subrayado superpuesto al SVG */
.correo-linea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--fa-black);
    pointer-events: none;
    clip-path: inset(0 100% 0 0);
}

.correo-boton:hover .correo-linea,
.correo-boton:focus-visible .correo-linea,
.correo.abierto .correo-linea {
    clip-path: inset(0);
    transition: clip-path var(--subrayado-duracion) ease-in-out;
}

/* Salida hacia la derecha */
.correo-linea.saliendo {
    clip-path: inset(0 0 0 100%);
    transition: clip-path var(--subrayado-duracion) ease-in-out;
}

/* Popover: --panel-x, --punta-y y --cola-x los calcula el script; el triángulo mide --space-16 de ancho y --space-8 de alto */
.correo-opciones {
    --popover-linea-alto: 50%;
    --popover-punta-min: 25%;
    --popover-punta-max: 75%;
    --popover-separacion: 6px;
    --popover-desplazamiento: 6px;
    position: absolute;
    z-index: 10;
    left: var(--panel-x, 0);
    top: var(--punta-y, 0);
    translate: 0 calc(-100% - var(--space-8));
    width: max-content;
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-4) var(--space-16);
    background-color: var(--fa-white);
    color: var(--fa-black);
    visibility: hidden;
    opacity: 0;
    transform: translateY(var(--popover-desplazamiento));
    transition:
        opacity var(--duracion-corta) ease,
        transform var(--duracion-corta) ease,
        visibility 0s linear var(--duracion-corta);
}

.correo.abierto .correo-opciones {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
        opacity var(--duracion-corta) ease,
        transform var(--duracion-corta) ease;
}

/* Triángulo con la punta en --cola-x */
.correo-opciones::after {
    content: '';
    position: absolute;
    top: 100%;
    left: calc(var(--cola-x, 50%) - var(--space-16) / 2);
    width: var(--space-16);
    height: var(--space-8);
    background-color: var(--fa-white);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
}

.correo-opciones .btn {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: lowercase;
    justify-content: center;
    min-height: var(--btn-height);
}

/* Línea entre los botones, centrada y con el alto relativo al del panel */
.correo-separador {
    align-self: stretch;
    width: 1px;
    margin-block: calc(-1 * var(--space-4));
    background: linear-gradient(currentColor, currentColor) center / 100% var(--popover-linea-alto) no-repeat;
}

.aviso-copiado {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}

/* Celular: panel al 90% de la pantalla y botones con alto táctil */
@media (max-width: 768px) {
  .correo-opciones {
    width: min(90vw, 100%);
  }

  .correo-opciones .btn {
    flex: 1;
    min-height: var(--btn-height-movil);
  }
}

@media (prefers-reduced-motion: reduce) {
  .correo-boton:hover .correo-linea,
  .correo-boton:focus-visible .correo-linea,
  .correo.abierto .correo-linea,
  .correo-opciones,
  .correo.abierto .correo-opciones {
    transition: none;
  }

  .correo-opciones {
    transform: none;
  }
}
</style>

<script>
  import { prepararRoll } from '../scripts/roll'

  const movil = window.matchMedia('(max-width: 768px)')
  const movimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)')

  document.querySelectorAll<HTMLElement>('.correo').forEach((bloque) => {
    const boton = bloque.querySelector<HTMLButtonElement>('.correo-boton')
    const imagen = boton?.querySelector('img')
    const linea = bloque.querySelector<SVGElement>('.correo-linea')
    const enviar = bloque.querySelector<HTMLAnchorElement>('.correo-enviar')
    const copiar = bloque.querySelector<HTMLButtonElement>('.correo-copiar')
    const aviso = bloque.querySelector('.aviso-copiado')
    const opciones = bloque.querySelector<HTMLElement>('.correo-opciones')
    if (!boton || !imagen || !linea || !enviar || !copiar || !opciones) return

    const textoCopiar = copiar.dataset.texto ?? ''
    let espera: number | undefined

    const abierto = () => bloque.classList.contains('abierto')

    const ponerTexto = (texto: string) => {
      copiar.textContent = texto
      if (!movimientoReducido.matches) prepararRoll(copiar)
    }

    // Subrayado: entra con el hover y sale hacia la derecha cuando deja de mostrarse
    const mostrada = () => boton.matches(':hover, :focus-visible') || abierto()
    let visible = false
    const revisarLinea = () => {
      const ahora = mostrada()
      if (ahora) linea.classList.remove('saliendo')
      else if (visible && !movimientoReducido.matches) linea.classList.add('saliendo')
      visible = ahora
    }
    boton.addEventListener('mouseenter', revisarLinea)
    boton.addEventListener('mouseleave', revisarLinea)
    boton.addEventListener('focus', revisarLinea)
    boton.addEventListener('blur', revisarLinea)
    linea.addEventListener('transitionend', () => {
      if (linea.classList.contains('saliendo')) linea.classList.remove('saliendo')
    })

    const marcar = (abrir: boolean) => {
      bloque.classList.toggle('abierto', abrir)
      boton.setAttribute('aria-expanded', String(abrir))
      revisarLinea()
    }

    // Cierre al elegir una opción; el foco vuelve al correo si estaba en el panel
    const cerrar = () => {
      const conFoco = opciones.contains(document.activeElement)
      marcar(false)
      if (conFoco) boton.focus()
    }

    const medida = (nombre: string) => parseFloat(getComputedStyle(opciones).getPropertyValue(nombre)) || 0

    // Altura de la punta: en celular, sobre el texto; en escritorio, la del clic dentro del rango mínimo y máximo
    const alturaPunta = (e: MouseEvent, texto: DOMRect) => {
      if (movil.matches) return -medida('--popover-separacion')
      if (e.detail === 0) return texto.height / 2
      const minimo = (texto.height * medida('--popover-punta-min')) / 100
      const maximo = (texto.height * medida('--popover-punta-max')) / 100
      return Math.max(minimo, Math.min(e.clientY - texto.top, maximo))
    }

    // Punta en el clic (en x) o en el centro con teclado; panel dentro de la ventana y del correo
    const ubicar = (e: MouseEvent) => {
      const caja = bloque.getBoundingClientRect()
      const texto = imagen.getBoundingClientRect()
      const punta = {
        x: e.detail === 0 ? texto.left + texto.width / 2 - caja.left : e.clientX - caja.left,
        y: texto.top - caja.top + alturaPunta(e, texto),
      }

      const ancho = opciones.offsetWidth
      // Margen de la cola (--space-16) más la mitad de su ancho (--space-16)
      const borde = medida('--space-16') * 1.5
      const ventana = document.documentElement.clientWidth
      const centro = texto.left + texto.width / 2 - caja.left

      let x: number
      if (movil.matches) x = (ventana - ancho) / 2 - caja.left
      else if (e.detail === 0) x = punta.x - ancho / 2
      else if (punta.x < centro) x = punta.x - borde
      else x = punta.x - ancho + borde

      const minimo = Math.max(0, -caja.left)
      const maximo = Math.min(caja.width, ventana - caja.left) - ancho
      x = Math.max(minimo, Math.min(x, maximo))
      const cola = Math.max(borde, Math.min(punta.x - x, ancho - borde))

      opciones.style.setProperty('--panel-x', `${x}px`)
      opciones.style.setProperty('--punta-y', `${punta.y}px`)
      opciones.style.setProperty('--cola-x', `${cola}px`)
    }

    // Texto original de copiar, repuesto al abrir para que no cambie durante el fundido de salida
    const reponerCopiar = () => {
      window.clearTimeout(espera)
      copiar.style.minWidth = ''
      if (aviso) aviso.textContent = ''
      if (copiar.dataset.estado) {
        delete copiar.dataset.estado
        ponerTexto(textoCopiar)
      }
    }

    boton.addEventListener('click', (e) => {
      if (!abierto()) {
        reponerCopiar()
        ubicar(e)
      }
      marcar(!abierto())
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && abierto()) {
        marcar(false)
        boton.focus()
      }
    })

    document.addEventListener('click', (e) => {
      if (abierto() && !bloque.contains(e.target as Node)) marcar(false)
    })

    enviar.addEventListener('click', cerrar)

    movil.addEventListener('change', () => marcar(false))

    // El botón conserva su ancho para que el panel no cambie de tamaño con el texto nuevo
    copiar.addEventListener('click', async () => {
      if (!movil.matches) copiar.style.minWidth = `${copiar.offsetWidth}px`
      copiar.dataset.estado = 'cambiado'
      try {
        await navigator.clipboard.writeText(copiar.dataset.correo ?? '')
        ponerTexto(copiar.dataset.copiado ?? '')
        if (aviso) aviso.textContent = 'Correo copiado'
      } catch {
        ponerTexto('no se pudo copiar')
      }
      window.clearTimeout(espera)
      espera = window.setTimeout(cerrar, 2000)
    })
  })
</script>
