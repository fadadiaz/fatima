---
import MenuMobile from './MenuMobile.astro'
const { flotante = false, bg = 'bg-pink' } = Astro.props
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/'

// Página actual: 'page' en la página exacta, 'true' en sus subpáginas
const actual = (destino: string) =>
  ruta === destino ? 'page' : ruta.startsWith(`${destino}/`) ? 'true' : undefined
---

<header
  class={`header-alt min-padding ${flotante ? 'nav-flotante' : bg}`}
  aria-hidden={flotante ? 'true' : undefined}
  inert={flotante}
>
  <!-- MOBILE -->
  <div class="nav-alt-mobile">
    <a href="/"><img alt="Texto fátima color negro" src="/logo-fatima.svg"></a>
    <MenuMobile bg={bg} />
  </div>
  <!-- DESKTOP/TABLET -->
  <nav class="nav-alt-full">
    <a class:list={['btn btn-pink-alt', { activo: actual('/proyectos') }]} aria-current={actual('/proyectos')} href="/proyectos"><span class="btn-texto">Proyectos</span></a>
    <a class:list={['btn btn-pink-alt', { activo: actual('/sobre-mi') }]} aria-current={actual('/sobre-mi')} href="/sobre-mi"><span class="btn-texto">Sobre mí</span></a>
    <a href="/"><img alt="Texto fátima color negro" width="81" height="25" src="/logo-fatima.svg"></a>
    <a class:list={['btn btn-pink-alt', { activo: actual('/recursos') }]} aria-current={actual('/recursos')} href="/recursos"><span class="btn-texto">Recursos</span></a>
    <a class="btn btn-fill" aria-current={actual('/contacto')} href="/contacto">Contacto<i class="fi fi-rs-arrow-up-right"></i></a>
  </nav>
</header>

<style>
  .header-alt {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-32);
    gap: var(--space-32);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color 0.3s ease;
  }

  /* Menú flotante del inicio: aparece cuando el encabezado sale de la pantalla */
  .nav-flotante {
    position: fixed;
    background-color: transparent;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s;
  }

  .nav-flotante.visible {
    opacity: 1;
    visibility: visible;
  }

  /* Variantes de entrada en prueba (data-animacion); tiempos, distancias y curva vienen del script del inicio */

  /* 1: caída suave */
  .nav-flotante[data-animacion="1"] {
    transform: translateY(calc(-1 * var(--nav-distancia)));
    transition:
      opacity var(--nav-salida) var(--nav-curva),
      transform var(--nav-salida) var(--nav-curva),
      visibility 0s linear var(--nav-salida);
  }

  .nav-flotante[data-animacion="1"].visible {
    transform: none;
    transition:
      opacity var(--nav-entrada) var(--nav-curva),
      transform var(--nav-entrada) var(--nav-curva),
      visibility 0s;
  }

  /* 2: persiana */
  .nav-flotante[data-animacion="2"] {
    opacity: 1;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path var(--nav-salida) var(--nav-curva),
      visibility 0s linear var(--nav-salida);
  }

  .nav-flotante[data-animacion="2"].visible {
    clip-path: inset(0);
    transition:
      clip-path var(--nav-entrada) var(--nav-curva),
      visibility 0s;
  }

  /* 3: links escalonados; la barra aparece al instante */
  .nav-flotante[data-animacion="3"] {
    opacity: 1;
    transition: visibility 0s linear var(--nav-salida);
  }

  .nav-flotante[data-animacion="3"].visible {
    transition: visibility 0s;
  }

  .nav-flotante[data-animacion="3"] :global(.nav-item) {
    opacity: 0;
    transform: translateY(var(--nav-distancia));
    transition:
      opacity var(--nav-salida) var(--nav-curva),
      transform 0s linear var(--nav-salida);
  }

  .nav-flotante[data-animacion="3"].visible :global(.nav-item) {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--nav-entrada) var(--nav-curva) calc(var(--i) * var(--nav-retraso)),
      transform var(--nav-entrada) var(--nav-curva) calc(var(--i) * var(--nav-retraso));
  }

  @media (prefers-reduced-motion: reduce) {
    .header-alt,
    .nav-flotante {
      transition: none;
    }
  }

  .header-alt.transparente {
    background-color: transparent;
  }

  /* MOBILE */
  .nav-alt-mobile {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-alt-mobile img { height: var(--space-16); }
  .nav-alt-full { display: none; }

  @media (min-width: 768px) {
    .nav-alt-mobile { display: none; }
    .nav-alt-full {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<script>
  const header = document.querySelector('.header-alt') as HTMLElement

  // comportamiento scroll en páginas normales
  if (!header.classList.contains('nav-flotante')) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header.classList.add('transparente')
      } else {
        header.classList.remove('transparente')
      }
    }, { passive: true })
  }
</script>