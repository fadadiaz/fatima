---
import MenuMobile from './MenuMobile.astro'
const { flotante = false, bg = 'bg-pink' } = Astro.props
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/'

// Página actual: 'page' en la página exacta, 'true' en sus subpáginas
const actual = (destino: string) =>
  ruta === destino ? 'page' : ruta.startsWith(`${destino}/`) ? 'true' : undefined
---

<header class={`header-alt min-padding ${flotante ? 'nav-flotante' : bg}`}>
  <!-- MOBILE -->
  <div class="nav-alt-mobile">
    <a href="/"><img alt="Texto fátima color negro" src="/logo-fatima.svg"></a>
    <MenuMobile bg={bg} />
  </div>
  <!-- DESKTOP/TABLET -->
  <nav class="nav-alt-full">
    <a class:list={['btn btn-pink-alt', { activo: actual('/proyectos') }]} aria-current={actual('/proyectos')} href="/proyectos"><span class="btn-texto">Proyectos</span></a>
    <a class:list={['btn btn-pink-alt', { activo: actual('/sobre-mi') }]} aria-current={actual('/sobre-mi')} href="/sobre-mi"><span class="btn-texto">Sobre mí</span></a>
    <a href="/"><img alt="Texto fátima color negro" width="81" height="25" src="/logo-fatima.svg"></a>
    <a class:list={['btn btn-pink-alt', { activo: actual('/recursos') }]} aria-current={actual('/recursos')} href="/recursos"><span class="btn-texto">Recursos</span></a>
    <a class="btn btn-fill" aria-current={actual('/contacto')} href="/contacto">Contacto<i class="fi fi-rs-arrow-up-right"></i></a>
  </nav>
</header>

<style>
  .header-alt {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-32);
    gap: var(--space-32);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color 0.3s ease;
  }

  .nav-flotante {
    position: fixed;
    background-color: transparent;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease, visibility 0.15s;
  }

  .nav-flotante.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-alt,
    .nav-flotante {
      transition: none;
    }
  }

  .header-alt.transparente {
    background-color: transparent;
  }

  /* MOBILE */
  .nav-alt-mobile {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-alt-mobile img { height: var(--space-16); }
  .nav-alt-full { display: none; }

  @media (min-width: 768px) {
    .nav-alt-mobile { display: none; }
    .nav-alt-full {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<script>
  const header = document.querySelector('.header-alt') as HTMLElement

  // comportamiento scroll en páginas normales
  if (!header.classList.contains('nav-flotante')) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header.classList.add('transparente')
      } else {
        header.classList.remove('transparente')
      }
    }, { passive: true })
  }
</script>