---
import MenuMobile from './MenuMobile.astro'
// transparente: sin fondo de color en el menú; el menú plegable conserva su fondo
const { flotante = false, bg = 'bg-pink', transparente = false } = Astro.props
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/'

// Página actual: 'page' en la página exacta, 'true' en sus subpáginas
const actual = (destino: string) =>
  ruta === destino ? 'page' : ruta.startsWith(`${destino}/`) ? 'true' : undefined
---

<header
  class={`header-alt min-padding ${flotante ? 'nav-flotante' : transparente ? 'transparente' : bg}`}
  aria-hidden={flotante ? 'true' : undefined}
  inert={flotante}
>
  <!-- MOBILE -->
  <div class="nav-alt-mobile">
    <a href="/"><img alt="Texto fátima color negro" src="/logo-fatima.svg"></a>
    <MenuMobile bg={bg} />
  </div>
  <!-- DESKTOP/TABLET -->
  <nav class="nav-alt-full">
    <a class:list={['btn btn-pink-alt', { activo: actual('/proyectos') }]} aria-current={actual('/proyectos')} href="/proyectos">Proyectos</a>
    <a class:list={['btn btn-pink-alt', { activo: actual('/galeria') }]} aria-current={actual('/galeria')} href="/galeria">Galería</a>
    <a href="/"><img alt="Texto fátima color negro" width="81" height="25" src="/logo-fatima.svg"></a>
    <a class:list={['btn btn-pink-alt', { activo: actual('/sobre-mi') }]} aria-current={actual('/sobre-mi')} href="/sobre-mi">Sobre mí</a>
    <a class="btn btn-fill" aria-current={actual('/contacto')} href="/contacto">Contacto</a>
  </nav>
</header>

<style>
  .header-alt {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-32);
    gap: var(--space-32);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color 0.3s ease;
  }

  /* Menú flotante del inicio */
  .nav-flotante {
    --duracion-entrada: 400ms;
    --retraso-entrada: 60ms;
    --duracion-salida: 250ms;
    --retraso-salida: 40ms;
    --distancia: 8px;
    --curva: cubic-bezier(0.22, 1, 0.36, 1);
    position: fixed;
    background-color: transparent;
  }

  .nav-flotante:not(.is-visible) {
    pointer-events: none;
  }

  /* Orden de entrada */
  .nav-flotante .nav-alt-full { --n: 5; }
  .nav-flotante .nav-alt-full > a[href="/proyectos"] { --i: 0; }
  .nav-flotante .nav-alt-full > a[href="/galeria"] { --i: 1; }
  .nav-flotante .nav-alt-full > a[href="/"] { --i: 2; }
  .nav-flotante .nav-alt-full > a[href="/sobre-mi"] { --i: 3; }
  .nav-flotante .nav-alt-full > a[href="/contacto"] { --i: 4; }
  .nav-flotante .nav-alt-mobile { --n: 2; }
  .nav-flotante .nav-alt-mobile > a[href="/"] { --i: 0; }
  .nav-flotante .nav-alt-mobile > :global(.btn-burger) { --i: 1; }

  /* Salida */
  .nav-flotante .nav-alt-full > a,
  .nav-flotante .nav-alt-mobile > a,
  .nav-flotante .nav-alt-mobile > :global(.btn-burger) {
    --demora-salida: calc((var(--n) - 1 - var(--i)) * var(--retraso-salida));
    opacity: 0;
    translate: 0 calc(-1 * var(--distancia));
    transform: translateY(var(--distancia));
    transition:
      opacity var(--duracion-salida) var(--curva) var(--demora-salida),
      translate var(--duracion-salida) var(--curva) var(--demora-salida),
      transform 0s linear calc(var(--demora-salida) + var(--duracion-salida));
  }

  /* Entrada */
  .nav-flotante.is-visible .nav-alt-full > a,
  .nav-flotante.is-visible .nav-alt-mobile > a,
  .nav-flotante.is-visible .nav-alt-mobile > :global(.btn-burger) {
    --demora-entrada: calc(var(--i) * var(--retraso-entrada));
    opacity: 1;
    translate: none;
    transform: none;
    transition:
      opacity var(--duracion-entrada) var(--curva) var(--demora-entrada),
      transform var(--duracion-entrada) var(--curva) var(--demora-entrada),
      translate 0s;
  }

  .nav-flotante.sin-transicion .nav-alt-full > a,
  .nav-flotante.sin-transicion .nav-alt-mobile > a,
  .nav-flotante.sin-transicion .nav-alt-mobile > :global(.btn-burger) {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-alt,
    .nav-flotante .nav-alt-full > a,
    .nav-flotante .nav-alt-mobile > a,
    .nav-flotante .nav-alt-mobile > :global(.btn-burger),
    .nav-flotante.is-visible .nav-alt-full > a,
    .nav-flotante.is-visible .nav-alt-mobile > a,
    .nav-flotante.is-visible .nav-alt-mobile > :global(.btn-burger) {
      transition: none;
    }
  }

  .header-alt.transparente {
    background-color: transparent;
  }

  /* MOBILE */
  .nav-alt-mobile {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-alt-mobile img { height: var(--space-16); }
  .nav-alt-full { display: none; }

  @media (min-width: 768px) {
    .nav-alt-mobile { display: none; }
    .nav-alt-full {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<script>
  const header = document.querySelector('.header-alt') as HTMLElement

  // comportamiento scroll en páginas normales
  if (!header.classList.contains('nav-flotante')) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header.classList.add('transparente')
      } else {
        header.classList.remove('transparente')
      }
    }, { passive: true })
  }
</script>