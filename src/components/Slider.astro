---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Animacion from './Animacion.astro'
import { animacionDe } from '../lib/animaciones'

const proyectos = await getCollection('proyectos')

// Solo el primer nivel de cada carpeta: las subcarpetas (otras/) quedan fuera del slider
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/proyectos/*/*.{png,jpg,jpeg,gif,webp}',
  { eager: true }
)

const slides = (
  await Promise.all(
    proyectos.flatMap((proyecto) => {
      if (!proyecto.data.carpeta) return []

      const prefijo = `/src/assets${proyecto.data.carpeta}/`

      return Object.entries(imagenes)
        .filter(([ruta]) => ruta.startsWith(prefijo))
        .map(async ([ruta, modulo]) => ({
          imagen: modulo.default,
          // Las animaciones pesadas con MP4 se muestran como video, sin versión animada en WebP
          animacion: /\.gif$/i.test(ruta) && (await animacionDe(ruta)) ? (ruta.split('/').pop() ?? ruta) : null,
          href: `/proyectos/${proyecto.id}`,
          titulo: proyecto.data.titulo,
        }))
    })
  )
).sort(() => Math.random() - 0.5)
---

<div class="slider-wrapper">
  <div class="slider-track">
    {slides.map((slide) => (
      <a href={slide.href} class="slide">
        {slide.animacion ? (
          <Animacion nombre={slide.animacion} alt={slide.titulo} />
        ) : (
          <Image src={slide.imagen} alt={slide.titulo} height={428} densities={[1, 2]} loading="lazy" />
        )}
      </a>
    ))}
    {/* Copia para el bucle, fuera del tabulado y de los lectores de pantalla */}
    {slides.map((slide) => (
      <a href={slide.href} class="slide slide-copia" aria-hidden="true" tabindex="-1">
        {slide.animacion ? (
          <Animacion nombre={slide.animacion} alt="" />
        ) : (
          <Image src={slide.imagen} alt="" height={428} densities={[1, 2]} loading="lazy" />
        )}
      </a>
    ))}
  </div>
</div>

<style>
  .slider-wrapper {
    width: 100%;
    /* clip en lugar de hidden: el foco no desplaza el contenedor por su cuenta */
    overflow: clip;
    /* Espacio para que el foco de las imágenes no quede recortado */
    padding-block: 5px;
    margin-block: -5px;
    /* El gesto horizontal mueve el slider; el vertical sigue desplazando la página */
    touch-action: pan-y;
    cursor: grab;
  }

  .slider-wrapper.arrastrando {
    cursor: grabbing;
  }

  .slider-track {
    display: flex;
    gap: var(--space-16);
    width: max-content;
    will-change: transform;
    user-select: none;
  }

  .slide {
    flex-shrink: 0;
    height: 428px;
    display: block;
  }

  .slide img,
  .slide :global(video) {
    height: 100%;
    width: auto;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
  }
</style>

<script>
  // Velocidad automática: media vuelta del carril cada 100 segundos
  const SEGUNDOS_POR_VUELTA = 100
  // Tiempo para pasar suavemente de una velocidad a otra (unos 600ms)
  const SUAVIZADO_MS = 200
  const UMBRAL_ARRASTRE = 5

  const movimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)')

  document.querySelectorAll<HTMLElement>('.slider-wrapper').forEach((contenedor) => {
    const carril = contenedor.querySelector<HTMLElement>('.slider-track')
    if (!carril) return
    const primeras = carril.querySelectorAll<HTMLElement>('.slide:not(.slide-copia)')
    const primeraCopia = carril.querySelector<HTMLElement>('.slide-copia')
    if (!primeras.length || !primeraCopia) return

    let posicion = 0
    let velocidad = 0
    let periodo = 1
    let encima = false
    let enfocado = false
    let visible = true
    let ultimoCuadro = performance.now()

    // Arrastre
    let arrastrando = false
    let punteroId: number | null = null
    let inicioX = 0
    let ultimoX = 0
    let ultimoTiempo = 0
    let velocidadArrastre = 0
    let recorrido = 0
    let bloquearClic = false

    // Largo de una vuelta: distancia entre la primera imagen y su copia
    const medirPeriodo = () => {
      periodo = Math.max(1, primeraCopia.offsetLeft - primeras[0].offsetLeft)
    }

    const velocidadAutomatica = () =>
      movimientoReducido.matches ? 0 : -periodo / SEGUNDOS_POR_VUELTA

    const envolver = () => {
      posicion = ((posicion % periodo) - periodo) % periodo
    }

    const cuadro = (ahora: number) => {
      const dt = Math.min(0.05, (ahora - ultimoCuadro) / 1000)
      ultimoCuadro = ahora

      if (!arrastrando) {
        const objetivo = encima || enfocado ? 0 : velocidadAutomatica()
        velocidad += (objetivo - velocidad) * (1 - Math.exp((-dt * 1000) / SUAVIZADO_MS))
        posicion += velocidad * dt
      }

      envolver()
      carril.style.transform = `translateX(${posicion}px)`
      if (visible) requestAnimationFrame(cuadro)
    }

    const arrancar = () => {
      ultimoCuadro = performance.now()
      requestAnimationFrame(cuadro)
    }

    new IntersectionObserver(([entrada]) => {
      const antes = visible
      visible = entrada.isIntersecting
      if (visible && !antes) arrancar()
    }).observe(contenedor)

    // Las imágenes cargan de a poco: el largo de la vuelta se recalcula
    new ResizeObserver(medirPeriodo).observe(carril)
    medirPeriodo()

    contenedor.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') encima = true
    })
    contenedor.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') encima = false
      // Un arrastre corto que termina afuera no recibe pointerup: se da por terminado
      if (arrastrando && !contenedor.hasPointerCapture(e.pointerId)) soltar(e)
      enfocado = false
    })

    contenedor.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return
      arrastrando = true
      punteroId = e.pointerId
      inicioX = ultimoX = e.clientX
      ultimoTiempo = performance.now()
      velocidadArrastre = 0
      recorrido = 0
      bloquearClic = false
    })

    contenedor.addEventListener('pointermove', (e) => {
      if (!arrastrando || e.pointerId !== punteroId) return
      const ahora = performance.now()
      const dx = e.clientX - ultimoX
      const dt = Math.max(1, ahora - ultimoTiempo) / 1000
      posicion += dx
      velocidadArrastre = velocidadArrastre * 0.7 + (dx / dt) * 0.3
      ultimoX = e.clientX
      ultimoTiempo = ahora
      recorrido = Math.abs(e.clientX - inicioX)

      // La captura del puntero empieza recién al arrastrar, para no anular los clics
      if (recorrido > UMBRAL_ARRASTRE && !contenedor.hasPointerCapture(e.pointerId)) {
        contenedor.setPointerCapture(e.pointerId)
        contenedor.classList.add('arrastrando')
      }
    })

    function soltar(e: PointerEvent) {
      // El foco que deja el clic o el toque no pausa el slider
      enfocado = false
      if (!arrastrando || e.pointerId !== punteroId) return
      arrastrando = false
      punteroId = null
      contenedor.classList.remove('arrastrando')
      if (contenedor.hasPointerCapture(e.pointerId)) contenedor.releasePointerCapture(e.pointerId)
      bloquearClic = recorrido > UMBRAL_ARRASTRE
      velocidad = performance.now() - ultimoTiempo > 100 ? 0 : velocidadArrastre
    }
    contenedor.addEventListener('pointerup', soltar)
    contenedor.addEventListener('pointercancel', soltar)

    // Después de arrastrar, el clic no abre el enlace
    contenedor.addEventListener(
      'click',
      (e) => {
        if (!bloquearClic) return
        e.preventDefault()
        e.stopPropagation()
        bloquearClic = false
      },
      true
    )

    contenedor.addEventListener('dragstart', (e) => e.preventDefault())

    contenedor.addEventListener('focusin', (e) => {
      const objetivo = e.target as HTMLElement
      if (!objetivo.matches(':focus-visible')) return
      enfocado = true
      const slide = objetivo.closest<HTMLElement>('.slide')
      if (!slide) return
      const izquierda = slide.offsetLeft + posicion
      const derecha = izquierda + slide.offsetWidth
      if (izquierda < 0 || derecha > contenedor.clientWidth) {
        // Alineada al borde izquierdo: la posición queda dentro de la primera vuelta
        posicion = -slide.offsetLeft
        velocidad = 0
      }
    })
    contenedor.addEventListener('focusout', (e) => {
      if (!contenedor.contains(e.relatedTarget as Node | null)) enfocado = false
    })

    arrancar()
  })
</script>