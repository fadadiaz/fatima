---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

const proyectos = await getCollection('proyectos')

// Solo el primer nivel de cada carpeta: las subcarpetas (otras/) quedan fuera del slider
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/proyectos/*/*.{png,jpg,jpeg,gif,webp}',
  { eager: true }
)

const slides = proyectos.flatMap((proyecto) => {
  if (!proyecto.data.carpeta) return []

  const prefijo = `/src/assets${proyecto.data.carpeta}/`

  return Object.entries(imagenes)
    .filter(([ruta]) => ruta.startsWith(prefijo))
    .map(([, modulo]) => ({
      imagen: modulo.default,
      href: `/proyectos/${proyecto.id}`,
      titulo: proyecto.data.titulo,
    }))
}).sort(() => Math.random() - 0.5)
---

<div class="slider-wrapper">
  <div class="slider-track">
    {slides.map((slide) => (
      <a href={slide.href} class="slide">
        <Image src={slide.imagen} alt={slide.titulo} height={428} densities={[1, 2]} loading="lazy" />
      </a>
    ))}
    {/* Copia para el bucle, fuera del tabulado y de los lectores de pantalla */}
    {slides.map((slide) => (
      <a href={slide.href} class="slide slide-copia" aria-hidden="true" tabindex="-1">
        <Image src={slide.imagen} alt="" height={428} densities={[1, 2]} loading="lazy" />
      </a>
    ))}
  </div>
</div>

<style>
  .slider-wrapper {
    width: 100%;
    overflow: hidden;
    /* Espacio para que el foco de las imágenes no quede recortado */
    padding-block: 5px;
    margin-block: -5px;
  }

  .slider-track {
    display: flex;
    gap: var(--space-16);
    width: max-content;
    animation: slide-infinito 100s linear infinite;
  }

  .slider-wrapper:hover .slider-track {
    animation-play-state: paused;
  }

  .slide {
    flex-shrink: 0;
    height: 428px;
    display: block;
  }

  .slide img {
    height: 100%;
    width: auto;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .slider-wrapper {
      overflow-x: auto;
    }

    .slider-track {
      animation: none;
    }

    .slide-copia {
      display: none;
    }
  }

  @keyframes slide-infinito {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
</style>