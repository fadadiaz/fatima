---
// Visor de imágenes a pantalla completa (galería y proyectos); la lógica está en scripts/visor.ts
interface Props {
  // Nombre del proyecto como enlace, a la izquierda de la barra
  conTitulo?: boolean
}

const { conTitulo = false } = Astro.props
---

<dialog class="visor" aria-label="Visor de imágenes">
  <div class="visor-fondo"></div>
  <!-- Las capas (imagen o video) las crea scripts/visor.ts -->
  <div class="visor-medio"></div>
  <!-- autofocus: la imagen también es enfocable y queda antes en el orden -->
  <button type="button" class="subrayado visor-control visor-cerrar" autofocus>cerrar</button>
  <div class="visor-barra">
    {conTitulo && <p class="visor-proyecto"><a class="visor-titulo" href="/proyectos"></a></p>}
    <div class="visor-controles">
      <button type="button" class="subrayado visor-control visor-anterior">anterior</button>
      <button type="button" class="subrayado visor-control visor-siguiente">siguiente</button>
    </div>
  </div>
</dialog>

<style>
  /* Opacidad de lo que queda detrás del visor abierto (0 a 1) */
  :global(:root) {
    --visor-opacidad-fondo: 0.35;
  }

  .visor {
    /* Caja máxima de la imagen abierta; cada imagen la llena según su proporción */
    --visor-ancho-max: 86vw;
    --visor-alto-max: 80svh;
    /* Fundido cruzado al cambiar de imagen y fundido de la miniatura a la versión grande */
    --visor-cruzado: 400ms;
    --visor-grande: 200ms;
    /* Zoom al hacer clic sobre la imagen */
    --visor-zoom-tiempo: 400ms;
    --visor-zoom-curva: cubic-bezier(0.22, 1, 0.36, 1);
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    overflow: hidden;
    background: transparent;
    color: var(--fa-black);
  }

  .visor::backdrop {
    background: transparent;
  }

  /* Desenfoque de todo lo que queda detrás, menú incluido */
  .visor-fondo {
    position: fixed;
    inset: 0;
    background: transparent;
    -webkit-backdrop-filter: blur(15px);
    backdrop-filter: blur(15px);
  }

  /* Respaldo sin backdrop-filter: fondo del sitio semitransparente */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .visor-fondo {
      background-color: color-mix(in srgb, var(--fa-white) 85%, transparent);
    }
  }

  /* Caja de una imagen según su proporción (--ratio = ancho / alto): la mayor que entra en el máximo */
  .visor-medio,
  .visor-medio :global(.visor-capa) {
    width: min(var(--visor-ancho-max), calc(var(--visor-alto-max) * var(--ratio, 1)));
    aspect-ratio: var(--ratio, 1);
  }

  /* Contenedor con la caja de la imagen actual; se anima al abrir y cerrar solo con transform.
     El centrado usa translate, así no se pisa con el transform de las animaciones */
  .visor-medio {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    cursor: pointer;
    user-select: none;
  }

  /* Capas apiladas en el centro, cada una con su caja; adentro, miniatura y versión grande, o el video */
  .visor-medio :global(.visor-capa) {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
  }

  .visor-medio :global(.visor-capa > *) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .visor-medio :global(.visor-grande) {
    opacity: 0;
    transition: opacity var(--visor-grande) ease;
  }

  .visor-medio :global(.visor-grande.cargada) {
    opacity: 1;
  }

  /* Zoom: solo las imágenes; los videos no se amplían */
  .visor-medio :global(.visor-capa) {
    cursor: zoom-in;
    touch-action: none;
  }

  .visor-medio :global(.visor-capa.ampliada) {
    cursor: grab;
  }

  .visor-medio :global(.visor-capa.arrastrando) {
    cursor: grabbing;
  }

  .visor-medio :global(.visor-capa.zoom-animado) {
    transition: transform var(--visor-zoom-tiempo) var(--visor-zoom-curva);
  }

  .visor-medio :global(.visor-capa-video) {
    cursor: default;
    touch-action: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .visor-medio :global(.visor-grande),
    .visor-medio :global(.visor-capa.zoom-animado) {
      transition: none;
    }
  }

  /* Sin GSAP: fundido con CSS */
  .visor.sin-motor .visor-fondo,
  .visor.sin-motor .visor-medio {
    transition: opacity 400ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .visor.sin-motor .visor-fondo,
    .visor.sin-motor .visor-medio {
      transition: none;
    }
  }

  .visor-control,
  .visor-titulo {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: var(--text-lg);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .visor-cerrar {
    position: fixed;
    top: var(--space-24);
    right: var(--space-48);
  }

  /* Escritorio: título en el 60% izquierdo, anterior y siguiente en el 40% derecho */
  .visor-barra {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-24) var(--space-48);
  }

  /* El enlace queda inline dentro del párrafo, con su subrayado por línea */
  .visor-proyecto {
    flex: 0 0 60%;
    padding-right: var(--space-24);
  }

  .visor-controles {
    flex: 1 1 40%;
    display: flex;
    justify-content: flex-end;
    gap: var(--space-24);
  }

  /* Celular: título en su fila, y debajo anterior y siguiente en los extremos */
  @media (max-width: 768px) {
    .visor-cerrar {
      top: var(--space-16);
      right: var(--space-16);
    }

    .visor-barra {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-16);
      padding: var(--space-16);
    }

    .visor-proyecto {
      flex: none;
      padding-right: 0;
    }

    .visor-controles {
      flex: none;
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
